# Video AI Detector — example configuration.
# Copy to ".env" (in the backend/ directory, or the process working directory)
# and uncomment to override. All variables use the VIDEO_AI_ prefix.

# --- Models (any binary real/fake classifier on the Hugging Face Hub) -------
# VIDEO_AI_VISUAL_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
# VIDEO_AI_VISUAL_MODEL_FALLBACK_ID=prithivMLmods/deepfake-detector-model-v1
# VIDEO_AI_AUDIO_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
# VIDEO_AI_AUDIO_MODEL_FALLBACK_ID=mo-thecreator/Deepfake-audio-detection

# --- Pipeline ---------------------------------------------------------------
# VIDEO_AI_NUM_FRAMES=24
# VIDEO_AI_MAX_FILE_SIZE_MB=100
# VIDEO_AI_MAX_DURATION_SECONDS=60
# VIDEO_AI_MIN_DURATION_SECONDS=2.0
# VIDEO_AI_AUDIO_SAMPLE_RATE=16000
# VIDEO_AI_SILENCE_RMS_THRESHOLD=0.003
# VIDEO_AI_AUDIO_TIMELINE_WINDOWS=6
# VIDEO_AI_AUDIO_TIMELINE_MIN_WINDOW_S=2.0

# --- Fusion -----------------------------------------------------------------
# VIDEO_AI_VISUAL_WEIGHT=0.6
# VIDEO_AI_AUDIO_WEIGHT=0.4

# --- Calibration (opt-in; OFF preserves raw model numbers) ------------------
# VIDEO_AI_CALIBRATION_ENABLED=false
# VIDEO_AI_CALIBRATION_FULL_CONFIDENCE_FRAMES=8
# VIDEO_AI_CALIBRATION_FULL_CONFIDENCE_AUDIO_SECONDS=3.0
# VIDEO_AI_CALIBRATION_MAX_SHRINK=0.35

# --- Runtime ----------------------------------------------------------------
# VIDEO_AI_FORCE_CPU=false

# --- API / CORS (comma-separated origins, or a JSON list) -------------------
# The frontend is served from the same origin, so this only matters for
# cross-origin API consumers. Do NOT use "*" in production.
# VIDEO_AI_CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
